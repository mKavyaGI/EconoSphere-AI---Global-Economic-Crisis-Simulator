# EconoSphere AI - API Environment Configuration
# Copy this file to .env:
#   cp .env.example .env

APP_NAME=EconoSphere AI
ENV=development

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=econosphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Authentication
JWT_SECRET=econosphere-local-dev-secret-key-change-in-prod
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO

# External AI APIs (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=
