APP_NAME=EconoSphere AI API (Production)
ENV=production
PRODUCTION_SAFETY_MODE=true

# CORS Configuration
# MUST be set to an explicit origin in production. Wildcards (*) and empty lists are strictly forbidden.
ALLOWED_ORIGINS=["https://frontend.example.com"]

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=econosphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PROD_POSTGRES_PASSWORD

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_PROD_NEO4J_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Security
JWT_SECRET=YOUR_PROD_JWT_SECRET
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO

# External APIs
OPENAI_API_KEY=YOUR_PROD_OPENAI_KEY
GROQ_API_KEY=YOUR_PROD_GROQ_KEY
